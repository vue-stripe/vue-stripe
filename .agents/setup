#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.local/bin:$PATH"

echo "[setup] Checking Node and pnpm"
SECONDS=0
node_major="$(tr -d '[:space:]' < .nvmrc)"
pnpm_version="$(node -p "require('./package.json').packageManager.split('@')[1]")"
tools=()
if [[ "$(node -p 'process.versions.node.split(".")[0]')" != "$node_major" ]]; then
  tools+=("node@$node_major")
fi
if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "$pnpm_version" ]]; then
  tools+=("pnpm@$pnpm_version")
fi
if (( ${#tools[@]} )); then
  npm install --global --prefix "$HOME/.local" "${tools[@]}"
  hash -r
fi
echo "[setup] Toolchain ready in ${SECONDS}s: Node $(node --version), pnpm $(pnpm --version)"

echo "[setup] Installing locked workspace dependencies"
SECONDS=0
pnpm install --frozen-lockfile
echo "[setup] Dependencies ready in ${SECONDS}s"
