{
  "name": "vue-stripe-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "turbo run format:check && prettier --check '*.{js,json,yml,yaml}' '.github/**/*.{yml,yaml}' 'scripts/**/*.{json,mjs}' 'tools/**/*.json'",
    "typecheck": "turbo run typecheck",
    "type-check": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:dev": "turbo run docs:dev",
    "docs:build": "turbo run docs:build",
    "playground:dev": "turbo run dev --filter=@vue-stripe/playground",
    "backend:dev": "turbo run dev --filter=@vue-stripe/backend",
    "vue-stripe:build": "turbo run build --filter=@vue-stripe/vue-stripe",
    "vue-stripe:test": "turbo run test --filter=@vue-stripe/vue-stripe",
    "stripe:seed": "bash scripts/seed-stripe.sh",
    "stripe:seed:clean": "bash scripts/seed-stripe.sh --clean",
    "stripe:seed:reset": "bash scripts/seed-stripe.sh --clean --force",
    "stripe:clean": "bash scripts/seed-stripe.sh --clean-only",
    "prepare": "husky",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "size": "pnpm --filter @vue-stripe/vue-stripe size",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vue-stripe/typescript-config": "workspace:*",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,vue}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "version": "0.0.1"
}
