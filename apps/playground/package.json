{
  "name": "@vue-stripe/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "build:spa": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.5.0",
    "@unhead/vue": "^3.4.2",
    "@vercel/analytics": "^2.0.1",
    "@vue-stripe/vue-stripe": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
