{
  "extends": "@vue-stripe/typescript-config/vue.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./.vitepress/*"]
    }
  },
  "include": [".vitepress/**/*", ".vitepress/**/*.vue"],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
