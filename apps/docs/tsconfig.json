{
  "extends": "@vue-stripe/typescript-config/vue.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./.vitepress/*"],
      "vitepress/dist/client/theme-default/components/*": ["./.vitepress/vitepress-component.d.ts"]
    }
  },
  "include": [".vitepress/**/*", ".vitepress/**/*.vue"],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
