{
  "name": "@vue-stripe/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "docs:dev": "vitepress dev",
    "build": "vitepress build",
    "docs:build": "vitepress build",
    "preview": "vitepress preview",
    "clean": "rm -rf .vitepress/dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue-stripe/vue-stripe": "workspace:*"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-og-image": "^2.18.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.1.5",
    "vue": "^3.5.22",
    "vue-tsc": "^3.3.13"
  }
}
