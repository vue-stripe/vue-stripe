{
  "name": "@vue-stripe/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "docs:dev": "vitepress dev",
    "build": "vitepress build",
    "docs:build": "vitepress build",
    "preview": "vitepress preview",
    "clean": "rm -rf .vitepress/dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.64.0",
    "@vue-stripe/vue-stripe": "workspace:*"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-og-image": "^2.21.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.16",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
