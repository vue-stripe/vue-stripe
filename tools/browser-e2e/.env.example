# Copy to .env (gitignored) and fill in. Shell variables win over this file.

# Test-mode keys of one Stripe account or sandbox (Dashboard > Developers > API keys).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Wallets: a dedicated Chrome profile directory, signed in to Google with a card in Google Pay.
# Not your main profile (~/Library/Application Support/Google/Chrome on macOS): Chrome locks a
# profile while it is open and refuses automation of its default directory.
# CHROME_PROFILE_DIR=/Users/you/.vue-stripe-e2e-chrome

# Where the tests open the docs and the playground. Defaults to the e2e:serve ports
# (http://localhost:4310 and http://localhost:4311). For wallets, paste the HTTPS URLs that
# e2e:tunnel prints, or your own registered domain.
# DOCS_URL=https://example.trycloudflare.com
# PLAYGROUND_URL=https://example.trycloudflare.com

# Chrome binary, when Google Chrome is not where Playwright's 'chrome' channel looks.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Wallets: pause so you can complete the Google Pay and Link payments by hand.
# E2E_INTERACTIVE=1

# Flows only (CI and headless runs).
# A test-mode pricing table on the same account (Dashboard > Product catalog > Pricing tables).
# PRICING_TABLE_ID=prctbl_xxx
# Keys of an Australian test account, for BECS Direct Debit; the BECS test skips without them.
# STRIPE_AU_SECRET_KEY=sk_test_xxx
# STRIPE_AU_PUBLISHABLE_KEY=pk_test_xxx
# Any Chromium build instead of Chrome (headless servers, CI).
# PW_EXECUTABLE_PATH=
# Issuing test opt-in (needs Stripe Issuing, which Stripe Sales enables).
# ISSUING=1
# Ports e2e:serve listens on.
# E2E_DOCS_PORT=4310
# E2E_PLAYGROUND_PORT=4311
# E2E_BACKEND_PORT=4312
