# Copy to .env (gitignored) and fill in. Shell variables win over this file.

# Test-mode keys of one Stripe account or sandbox (Dashboard > Developers > API keys).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# A test-mode pricing table on the same account (Dashboard > Product catalog > Pricing tables).
PRICING_TABLE_ID=prctbl_xxx

# Where the tests open the docs and the playground. Defaults to the e2e:serve ports
# (http://localhost:4310 and http://localhost:4311). For wallets, paste the HTTPS URLs that
# e2e:tunnel prints, or your own registered domain.
# DOCS_URL=https://example.trycloudflare.com
# PLAYGROUND_URL=https://example.trycloudflare.com

# Wallets project only: a dedicated Chrome profile directory, signed in to Google with a card
# in Google Pay. Not your everyday profile (Chrome blocks automation of the default one).
# CHROME_PROFILE_DIR=/Users/you/.vue-stripe-e2e-chrome

# Optional switches.
# E2E_INTERACTIVE=1       wallets: open the wallet sheet and pause for you to pay
# ISSUING=1               run the Issuing test (needs an Issuing account; see README)
# PW_EXECUTABLE_PATH=     any Chromium or Chrome binary instead of the installed Chrome
# E2E_DOCS_PORT=4310      ports e2e:serve listens on
# E2E_PLAYGROUND_PORT=4311
# E2E_BACKEND_PORT=4312
