{
  "name": "@vue-stripe/vue-stripe",
  "version": "6.0.0",
  "description": "Vue Stripe elements and composables for Stripe.js",
  "author": "Joff Tiquez <jofftiquez@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vue-stripe/vue-stripe.git"
  },
  "homepage": "https://vuestripe.com",
  "bugs": "https://github.com/vue-stripe/vue-stripe/issues",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./style.css": "./dist/vue-stripe.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build --mode umd && tsc -p tsconfig.build.json && node scripts/declarations.mjs",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "size": "size-limit"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "stripe",
    "payment",
    "checkout",
    "elements",
    "composition-api",
    "typescript"
  ],
  "peerDependencies": {
    "@stripe/stripe-js": "^10.0.0",
    "vue": "^2.7.0 || ^3.0.0"
  },
  "dependencies": {
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@stripe/stripe-js": "^10.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue-stripe/typescript-config": "workspace:*",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "stripe-js-10.0.0": "npm:@stripe/stripe-js@10.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43"
  }
}
