{
  // vue-tsc on Vue 3 against the built dist/types: `vue` is the vue3 alias, and
  // dist/types resolves vue-demi from the library package (its Vue 3 copy).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    // TypeScript 6 default: an unresolvable side-effect import in dist/types fails (#622).
    "noUncheckedSideEffectImports": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [],
    "paths": {
      "vue": ["../node_modules/vue3"]
    }
  },
  // As in the apps that report template type errors (#671).
  "vueCompilerOptions": { "strictTemplates": true },
  "include": ["*.vue"]
}
