{
  // vue-tsc on Vue 3 against the built dist/types: `vue` is the vue3 alias, and
  // dist/types resolves vue-demi from the library package (its Vue 3 copy).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "jsx": "preserve",
    "types": [],
    "paths": {
      "vue": ["../node_modules/vue3"]
    }
  },
  "include": ["*.vue"]
}
